# Simulator LLM API key — required for running tests with the Haiku-backed simulator.
# Used by PR-3+ harness; PR-1 (scaffold) does not invoke any LLM.
ANTHROPIC_API_KEY=

# Optional overrides for definition lookups.
# Defaults to <evals-pkg-dir>/profiles and <evals-pkg-dir>/tests.
# EVALS_PROFILES_DIR=
# EVALS_TESTS_DIR=

# Absolute path to the vellum-assistant checkout that `vellum hatch --source`
# builds the CLI/daemon images from. Defaults to the repo root four levels
# above src/lib/adapters/vellum.ts, which is only correct when the harness
# lives inside a vellum-assistant checkout. Set this when running from the
# standalone evals repo, or to point successive runs at different worktrees
# when comparing branches.
# EVALS_VELLUM_SOURCE=/absolute/path/to/vellum-assistant

# ngrok authtoken — used by `evals server --ngrok` to expose the local
# report server via a stable ngrok HTTPS tunnel. The `ngrok` agent
# reads this env var natively at startup, so no `ngrok config
# add-authtoken` step is required when this is set.
# Without a token, ngrok still works against the random ephemeral
# subdomain but is rate-limited and the session times out after ~2h.
# NGROK_AUTHTOKEN=

# Eval launcher — when set, `evals run --launcher` delegates execution to
# the platform's dedicated eval environment (Kubernetes Jobs) instead of
# running locally. The CLI posts to {EVAL_RESULTS_UPLOAD_URL}/api/evals/trigger
# and polls {EVAL_RESULTS_UPLOAD_URL}/api/evals/status/{runId}.
# EVAL_RESULTS_UPLOAD_URL defaults to https://qa.vellum.ai if unset.
# EVAL_RESULTS_UPLOAD_URL=https://qa.vellum.ai
# QA_AUTH_TOKEN=
